# Pre-Arranged Funeral Estimate Tool — environment variables
# Copy this file to `.env.local` for local dev, and add the same vars in Vercel for production.

# REQUIRED — published Google Sheet CSV URL
# In Google Sheets: File → Share → Publish to web → choose the pricing sheet/tab → CSV → Publish.
# Paste the resulting URL below. The app fetches this on every page load.
NEXT_PUBLIC_SHEETS_CSV_URL="https://docs.google.com/spreadsheets/d/REPLACE_WITH_YOUR_SHEET_ID/gviz/tq?tqx=out:csv&sheet=Pricing"

# OPTIONAL — business phone shown on the PDF and contact card.
NEXT_PUBLIC_BUSINESS_PHONE="028 9038 1080"

# REQUIRED for the "Send to Crymble & Sons WhatsApp" button — Beepmate API.
# Get these from your Beepmate account. The endpoint is called server-side only,
# so do NOT prefix these with NEXT_PUBLIC_.
BEEPMATE_API_KEY="your-beepmate-api-key"
BEEPMATE_CHAT_ID="your-beepmate-chat-or-group-id"

# OPTIONAL — Google Apps Script URL that uploads the estimate PDF to Drive
# and returns a shareable link. The SAME script also handles the Estimates
# log (dashboard) and the Users table (self-service password change), so
# DRIVE_UPLOAD_URL is the single integration point for all sheet I/O.
# DRIVE_UPLOAD_SECRET must match SHARED_SECRET inside the Apps Script.
DRIVE_UPLOAD_URL="https://script.google.com/macros/s/REPLACE/exec"
DRIVE_UPLOAD_SECRET="long-random-hex-string-matching-the-apps-script"

# OPTIONAL — Headstone tracker Apps Script (the sibling DC&S Memorial Tracker
# project). When set, the Headstones section of the dashboard fetches orders
# from this URL via a server-side proxy at /api/headstones/*. The secret is
# a follow-up — for now we just point at the existing deployment URL.
HEADSTONE_APPS_SCRIPT_URL="https://script.google.com/macros/s/REPLACE/exec"

# OPTIONAL — shared key for the read-only summary feed at /api/feed, used by
# the David Crymble & Sons website Control Centre dashboard to show live plan
# counts. The website sends this as an `x-feed-key` header; set the SAME value
# here (Vercel) and in the website's Settings › Integrations. Use a long random
# string. Leave unset to keep the feed disabled (returns 401).
FEED_KEY="long-random-string-shared-with-the-website"
