# Pre-Arranged Funeral Estimate Tool — environment variables
# Copy this file to `.env.local` for local dev, and add the same vars in Vercel for production.

# REQUIRED — published Google Sheet CSV URL
# In Google Sheets: File → Share → Publish to web → choose the pricing sheet/tab → CSV → Publish.
# Paste the resulting URL below. The app fetches this on every page load.
NEXT_PUBLIC_SHEETS_CSV_URL="https://docs.google.com/spreadsheets/d/REPLACE_WITH_YOUR_SHEET_ID/gviz/tq?tqx=out:csv&sheet=Pricing"

# OPTIONAL — business phone shown on the PDF and contact card.
NEXT_PUBLIC_BUSINESS_PHONE="028 9038 1080"

# REQUIRED for the "Send to Crymble & Sons WhatsApp" button — Beepmate API.
# Get these from your Beepmate account. The endpoint is called server-side only,
# so do NOT prefix these with NEXT_PUBLIC_.
BEEPMATE_API_KEY="your-beepmate-api-key"
BEEPMATE_CHAT_ID="your-beepmate-chat-or-group-id"
